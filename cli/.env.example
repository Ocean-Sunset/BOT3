# Prowl bot - environment variables
# Copy this file to `.env.local` on the server and fill in your real values.
# Required:
TOKEN=your_discord_bot_token
DATABASE_URL=postgres://user:pass@host/db

# Optional:
DASHBOARD_URL=https://prowlbot.xyz
SITE_URL=https://prowlbot.xyz

# Direct dashboard HTTP bridge (must match the website's BOT_HTTP_TOKEN).
# Disables the bridge if left empty. Port must be reachable from Vercel.
BOT_HTTP_TOKEN=
BOT_HTTP_PORT=24612

# Semantic search microservice (BGE-small-en-v1.5, runs alongside the bot).
# Disabled unless explicitly enabled. Vercel calls /semantic-search with the
# same BOT_HTTP_TOKEN. Model + page embeddings are loaded once at startup.
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_MIN_SCORE=0.20
SEMANTIC_TOP_K=8
SEMANTIC_CACHE_PATH=data/semantic_cache.json

# Verification captchas
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# AI (optional)
OPENAI_API_KEY=

# Social alerts (optional)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
NITTER_INSTANCE=https://nitter.net
